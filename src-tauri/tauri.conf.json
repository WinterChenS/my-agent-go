{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anvil",
  "version": "0.1.22",
  "identifier": "app.anvil.desktop",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "WinterChenS",
    "copyright": "Copyright © 2026 WinterChenS",
    "shortDescription": "Anvil desktop agent host",
    "longDescription": "Anvil is a desktop host for AI coding agents with a built-in browser, tool approvals, schedules and a local session ledger.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../frontend/dist/": "frontend/dist/"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/WinterChenS/my-agent-go/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1RDAzQkQ2OUI0NUVCOTUKUldTVjYwV2IxanZRUldlZ1c0TmJodFFZcmp6UHVtcHNCRmJmdWRrU3JYMmpxQ3BaK282UGd5N04K",
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
