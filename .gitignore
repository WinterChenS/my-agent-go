# 本地工具链（F00：wails3 CLI 装在项目内，不进版本库）
/.tools/

# Node
node_modules/
frontend/dist/
*.tsbuildinfo

# 运行时产物
/dist/
/build/bin/
artifacts/
*.exe
*.dll

# 构建日志（证据日志例外：docs/evidence/raw/** 必须入库）
/build/*.log
!/docs/evidence/raw/*.log

# OS / 编辑器
.DS_Store
Thumbs.db
*.swp
.idea/

# 项目内部工作数据（会话记忆等），不进产品版本库
/.workbuddy/

# 证据目录里的临时草稿
/docs/evidence/raw/_*.tmp.txt

# 本地临时运行数据（应用 home、fixture 记录、截图草稿）
/.tmp/

# 集成证据运行目录：按 git revision 分目录，属于"针对某一次提交现场生成的产物"。
# 提交它会让 revision 立刻对不上（下一次提交就换 HEAD），门禁会判过期；
# 因此只保留生成能力，不入库。可长期引用的结论进 docs/evidence/raw/ 与 docs/evidence/*.md。
/docs/evidence/runs/
